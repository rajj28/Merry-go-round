# Loop — workspace-scoped environment configuration (EXAMPLE).
#
# Copy this file to `.env` and fill in real values. Do NOT commit `.env`.
# All tokens are workspace-scoped and stay within the user's trust boundary
# (Req 14.2). `.env` is git-ignored.

# --- Slack (workspace-scoped) ------------------------------------------------
# Bot token (xoxb-...) — message read, App Home, Assistant, chat:write as user.
SLACK_BOT_TOKEN=xoxb-your-bot-token
# App-level token (xapp-...) for Socket Mode.
SLACK_APP_TOKEN=xapp-your-app-token
# User token (xoxp-...) — REQUIRED for Real-Time Search (assistant.search.context
# runs on the user token, verified on the sandbox) and for posting Polite Nudges /
# delegations AS the user (Req 7.3, 10). Granted via the user OAuth scopes
# (search:read.public, chat:write).
SLACK_USER_TOKEN=xoxp-your-user-token
# Signing secret for verifying inbound Slack request signatures.
SLACK_SIGNING_SECRET=your-signing-secret

# --- LLM provider (two-tier reasoning) ---------------------------------------
# Which backend serves the fast/filter and smart/precise tiers: "groq" (default,
# FREE, OpenAI-compatible) or "anthropic" (optional Claude path).
LLM_PROVIDER=groq

# --- Groq (FREE, OpenAI-compatible) ------------------------------------------
# Groq API key. Primary env var name is GROK_API (falls back to GROQ_API_KEY).
GROK_API=gsk_your-groq-key
# OpenAI-compatible base URL for Groq (override only to pin a different endpoint).
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Fast/filter tier model (Watcher classifier).
LOOP_FAST_MODEL=llama-3.1-8b-instant
# Smart/precise tier model (Adjudicator reasoning + nudge drafting).
LOOP_SMART_MODEL=llama-3.3-70b-versatile

# --- Claude reasoning tier (Anthropic API — OPTIONAL) ------------------------
# Only needed when LLM_PROVIDER=anthropic. Leave blank to use the free Groq path.
ANTHROPIC_API_KEY=sk-ant-your-key
# Model identifiers (override only if you need to pin a specific snapshot).
HAIKU_MODEL=claude-haiku-4-5
OPUS_MODEL=claude-opus-4-8

# --- GitHub MCP (artifact verification) --------------------------------------
# The official REMOTE GitHub MCP server (hosted by GitHub). The Verifier calls its
# `get_pull_request` tool to read real PR merge state before nudging/auto-closing.
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
# A GitHub Personal Access Token (PAT) used as the bearer token to the MCP server.
# Fine-grained (read access to your throwaway demo repo) or classic (repo scope).
GITHUB_MCP_TOKEN=github_pat_your-throwaway-repo-token

# --- Storage & scheduling ----------------------------------------------------
# Path to the embedded SQLite Obligation Graph.
LOOP_DATABASE_PATH=loop.db
# Watcher sweep interval in seconds (must be <= 60, Req 2.1).
LOOP_SWEEP_INTERVAL_SECONDS=30
# Comma-separated channel IDs to scope live detection to the demo channel; leave
# blank for the whole workspace. e.g. LOOP_WATCH_CHANNELS=C0123456,C0789ABC
LOOP_WATCH_CHANNELS=

# --- Runtime mode ------------------------------------------------------------
# When true, the app loads the seeded Northwind demo org into the live graph on
# boot (timestamps rebased to "now"), so the dashboard, nudge / quick-nudge, and
# the GitHub PR-merge auto-heal are all fully interactive on the demo data — not
# just a static published view (Req 15). Set false for real RTS-driven detection.
LOOP_DEMO_MODE=false

# --- UI style ----------------------------------------------------------------
# Block Kit row rendering: "sections" (default; section + avatar accessory +
# actions) or "cards" (newer Block Kit `card` block — avatar icon + title +
# subtitle + up to 3 buttons — plus an aging bar chart on Assistant query replies).
# LOOP_UI_STYLE is the global default for both surfaces; LOOP_HOME_STYLE and
# LOOP_ASSISTANT_STYLE override per surface (each falls back to LOOP_UI_STYLE).
# Cards are opt-in; confirm they render in your workspace before demoing on them.
LOOP_UI_STYLE=sections
# Per-surface overrides (leave blank to use LOOP_UI_STYLE):
LOOP_HOME_STYLE=
LOOP_ASSISTANT_STYLE=

# --- App Home layout ---------------------------------------------------------
# "stack" (default) renders the classic three stacked sections. "compact" renders
# the command-center layout: a horizontal `carousel` of blocked-on-you cards,
# compact one-line waiting rows, and tiny auto-closed context lines — far less
# scrolling as the org scales. The `carousel` block is new; confirm it renders in
# your workspace (Block Kit Builder + your sandbox App Home) before demoing on it.
LOOP_HOME_LAYOUT=stack

# Optional https URL for a small Loop logo rendered above the App Home hero header.
LOOP_LOGO_URL=

# Your Slack user id (the App Home viewer). Required by the render-check harness
# (loop.spikes.live_demo --seeded) so it can publish the view to you. Find it in
# Slack: your profile → ⋮ → "Copy member ID" (looks like U01ABCDEF).
LOOP_USER_ID=

# --- Testing -----------------------------------------------------------------
# Hypothesis profile to load: `dev` (default) or `ci`. Both enforce >= 100
# examples per property test.
HYPOTHESIS_PROFILE=dev
